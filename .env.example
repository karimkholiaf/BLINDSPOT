# Primary: Claude Sonnet 5 via OpenRouter. Prepaid credit, so spend is hard-capped.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Fallback: Google Gemini free tier, used automatically when the OpenRouter
# credit runs out. Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: pin every request to a single model, bypassing the chain.
# Used by scripts/adversarial-test.mjs to benchmark one model at a time.
# BLINDSPOT_MODEL=anthropic/claude-sonnet-5
